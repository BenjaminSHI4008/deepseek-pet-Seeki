{
  "version": 2,
  "character": "Deepseek",
  "direction": "south",
  "defaultAction": "idle",
  "server": {
    "wsUrl": "ws://127.0.0.1:3080/api/pet.ws"
  },

  "statuses": {
    "working":    { "text": "Deep diving...", "color": "#4fc3f7", "action": null },
    "idle":       { "text": "Completed",       "color": "#7ed957", "action": "happy" },
    "terminated": { "text": "Stopped",         "color": "#ff5252", "action": null },
    "offline":    { "text": "Offline",         "color": "#9e9e9e", "action": null }
  },

  "actions": {
    "happy": { "label": "开心", "fps": 5,   "folder": "Happy",                  "count": 9 },
    "idle":  { "label": "待机", "fps": 4,   "folder": "Breathing_Idle",          "count": 4 },
    "walk":  { "label": "走路", "fps": 8,   "folder": "Crouched_Walking",        "count": 6 },
    "sleep": { "label": "睡觉", "fps": 2.5, "folder": "Close_eyes_and_sleeping", "count": 9, "intro": [0, 2] }
  },

  "triggers": {
    "drag":      { "during": "walk", "after": "idle" },
    "clickIdle": { "to": "happy", "returnTo": "idle", "afterMs": 2000 },
    "wake":      { "from": ["sleep"], "to": "idle" },
    "timeout":   { "from": "idle", "to": "sleep", "afterMs": 15000 },
    "statusActionMs": 2000
  }
}
